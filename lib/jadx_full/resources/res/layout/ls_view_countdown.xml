<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ls_bg_countdown_panel"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:clipToOutline="true">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ls_detail_countdown_top_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ls_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvCountdownTitle"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="12dp"
        android:text="@string/ls_countdown_title_ko"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_font_700"/>
    <com.transsion.livesports.detail.ui.widget.LiveSportsFlipNumberView
        android:id="@+id/fnvDays"
        android:layout_width="60dp"
        android:layout_height="51dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintEnd_toStartOf="@+id/fnvHours"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCountdownTitle"/>
    <com.transsion.livesports.detail.ui.widget.LiveSportsFlipNumberView
        android:id="@+id/fnvHours"
        android:layout_width="60dp"
        android:layout_height="51dp"
        app:layout_constraintBottom_toBottomOf="@+id/fnvDays"
        app:layout_constraintEnd_toStartOf="@+id/fnvMinutes"
        app:layout_constraintStart_toEndOf="@+id/fnvDays"
        app:layout_constraintTop_toTopOf="@+id/fnvDays"/>
    <com.transsion.livesports.detail.ui.widget.LiveSportsFlipNumberView
        android:id="@+id/fnvMinutes"
        android:layout_width="60dp"
        android:layout_height="51dp"
        app:layout_constraintBottom_toBottomOf="@+id/fnvDays"
        app:layout_constraintEnd_toStartOf="@+id/fnvSeconds"
        app:layout_constraintStart_toEndOf="@+id/fnvHours"
        app:layout_constraintTop_toTopOf="@+id/fnvDays"/>
    <com.transsion.livesports.detail.ui.widget.LiveSportsFlipNumberView
        android:id="@+id/fnvSeconds"
        android:layout_width="60dp"
        android:layout_height="51dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/fnvDays"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fnvMinutes"
        app:layout_constraintTop_toTopOf="@+id/fnvDays"/>
    <View
        android:background="@color/ls_color_countdown_digit_divider"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/fnvDays"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fnvMinutes"
        app:layout_constraintTop_toTopOf="@+id/fnvDays"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ls_white_60"
        android:gravity="center"
        android:id="@+id/tvDaysLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ls_countdown_days"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/fnvDays"
        app:layout_constraintStart_toStartOf="@+id/fnvDays"
        app:layout_constraintTop_toBottomOf="@+id/fnvDays"
        style="@style/style_font_400"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ls_white_60"
        android:gravity="center"
        android:id="@+id/tvHoursLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ls_countdown_hours"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/fnvHours"
        app:layout_constraintStart_toStartOf="@+id/fnvHours"
        app:layout_constraintTop_toTopOf="@+id/tvDaysLabel"
        style="@style/style_font_400"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ls_white_60"
        android:gravity="center"
        android:id="@+id/tvMinutesLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ls_countdown_minutes"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/fnvMinutes"
        app:layout_constraintStart_toStartOf="@+id/fnvMinutes"
        app:layout_constraintTop_toTopOf="@+id/tvDaysLabel"
        style="@style/style_font_400"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ls_white_60"
        android:gravity="center"
        android:id="@+id/tvSecondsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ls_countdown_seconds"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/fnvSeconds"
        app:layout_constraintStart_toStartOf="@+id/fnvSeconds"
        app:layout_constraintTop_toTopOf="@+id/tvDaysLabel"
        style="@style/style_font_400"/>
</androidx.constraintlayout.widget.ConstraintLayout>
