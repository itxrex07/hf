<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.noober.background.view.BLConstraintLayout
        android:id="@+id/productCard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        app:bl_corners_radius="4dp"
        app:bl_solid_color="@color/gray_dark_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecommShare">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/productImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/corner_style_left_4"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/white_80"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/productName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:fontFamily="@font/mulish_regular"
            android:textAlignment="viewStart"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/ctaBorder"
            app:layout_constraintStart_toEndOf="@+id/productImage"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/productPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/mulish_bold"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/productImage"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="9sp"
            android:textColor="@color/white_60"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/productOriginalPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@font/mulish_regular"
            android:textAlignment="viewStart"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/productPrice"
            app:layout_constraintEnd_toStartOf="@+id/ctaBorder"
            app:layout_constraintStart_toEndOf="@+id/productPrice"
            app:layout_constraintTop_toTopOf="@+id/productPrice"/>
        <com.noober.background.view.BLFrameLayout
            android:id="@+id/ctaBorder"
            android:background="@drawable/bg_cta_btn"
            android:padding="1dp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.noober.background.view.BLTextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/ctaButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="50dp"
                android:fontFamily="@font/mulish_bold"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                app:bl_corners_radius="14dp"
                app:bl_gradient_angle="0"/>
        </com.noober.background.view.BLFrameLayout>
    </com.noober.background.view.BLConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/ecommLike"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mulish_regular"
        app:drawableTopCompat="@drawable/drawable_ecomm_like"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/ecommShare"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/mulish_regular"
        app:drawableTopCompat="@mipmap/icon_ecomm_share"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecommLike"/>
    <LinearLayout
        android:id="@+id/platformLayout"
        android:background="@drawable/bg_circle_white"
        android:padding="1dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productCard">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/platformIcon"
            android:background="@color/white"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/circle_style"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/platformName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/mulish_bold"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/platformLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/platformLayout"
        app:layout_constraintTop_toTopOf="@+id/platformLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
