<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llPremiumBanner"
    android:visibility="gone"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <View
        android:background="@drawable/ls_premium_banner_art"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:translationY="-15dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="52dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="#332701"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ls_premium_unlock_benefits"
                android:fontFamily="@font/mulish_bold"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#332701"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ls_premium_catch_top_matches"
                android:fontFamily="@font/mulish_regular"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#332701"
            android:gravity="center"
            android:background="@drawable/ls_bg_premium_button"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="72dp"
            android:text="@string/ls_premium_unlock"
            android:fontFamily="@font/mulish_bold"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
</FrameLayout>
