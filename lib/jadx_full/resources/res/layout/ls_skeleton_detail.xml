<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ls_gray_dark_00"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/skeletonPlayer"
        android:background="@color/ls_white_06"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/skeletonPb"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="@color/ls_brand_gradient_center"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonPlayer"
        app:layout_constraintEnd_toEndOf="@+id/skeletonPlayer"
        app:layout_constraintStart_toStartOf="@+id/skeletonPlayer"
        app:layout_constraintTop_toTopOf="@+id/skeletonPlayer"/>
    <View
        android:id="@+id/skeletonLeague"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="120dp"
        android:layout_height="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonPlayer"/>
    <View
        android:id="@+id/skeletonLogo1"
        android:background="@drawable/ls_skeleton_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="70dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonLeague"/>
    <View
        android:id="@+id/skeletonLogo2"
        android:background="@drawable/ls_skeleton_circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonLeague"/>
    <View
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="60dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/skeletonLogo1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/skeletonLogo1"/>
    <View
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="60dp"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/skeletonLogo1"
        app:layout_constraintStart_toStartOf="@+id/skeletonLogo1"
        app:layout_constraintTop_toBottomOf="@+id/skeletonLogo1"/>
    <View
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="60dp"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/skeletonLogo2"
        app:layout_constraintStart_toStartOf="@+id/skeletonLogo2"
        app:layout_constraintTop_toBottomOf="@+id/skeletonLogo2"/>
    <View
        android:id="@+id/skeletonBoost"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonLogo1"/>
    <View
        android:id="@+id/skeletonTab"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonBoost"/>
    <View
        android:id="@+id/skeletonContent1"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonTab"/>
    <View
        android:id="@+id/skeletonContent2"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonContent1"/>
    <View
        android:id="@+id/skeletonContent3"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonContent2"/>
    <View
        android:id="@+id/skeletonContent4"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonContent3"/>
    <View
        android:id="@+id/skeletonContent5"
        android:background="@drawable/ls_skeleton_rounded"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonContent4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
