<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ls_bg_operate_card_surface"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="68dp"
    android:clipToOutline="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="@dimen/ls_text_size_12"
            android:textColor="@color/ls_white"
            android:ellipsize="end"
            android:id="@+id/ls_tv_sport_news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/style_font_400"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="@dimen/ls_text_size_11"
                android:textColor="@color/ls_white_60"
                android:ellipsize="end"
                android:id="@+id/ls_tv_sport_news_views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/style_font_400"/>
            <View
                android:background="@color/ls_white_20"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginHorizontal="4dp"/>
            <TextView
                android:textSize="@dimen/ls_text_size_11"
                android:textColor="@color/ls_white_60"
                android:ellipsize="end"
                android:id="@+id/ls_tv_sport_news_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/style_font_400"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/ls_iv_sport_news_thumb"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
</LinearLayout>
