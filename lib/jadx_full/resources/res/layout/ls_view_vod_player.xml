<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/vVideoLoadingBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="@color/ls_brand_gradient_center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/ls_white"
        android:id="@+id/tvSeekPreview"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_font_600"/>
    <View
        android:id="@+id/vControlBarScrim"
        android:background="@drawable/ls_bg_player_control_bar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottomControlBar"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/ivPlayPause"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_pause"
            android:scaleType="centerInside"/>
        <com.transsion.livesports.base.widget.SecondariesSeekBar
            android:id="@+id/seekBar"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            app:ssb_bar_center_color="@color/ls_brand_gradient_center"
            app:ssb_bar_end_color="@color/ls_brand_gradient_end"
            app:ssb_bar_start_color="@color/ls_brand_gradient_start"
            app:ssb_bg_color="@color/ls_white_40"
            app:ssb_secondaries_color="@color/ls_white_80"
            app:ssb_thumb_color="@color/ls_white"
            app:ssb_thumb_size="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ls_white"
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00/00:00"
            style="@style/style_font_400"/>
        <ImageView
            android:id="@+id/ivPip"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_pip"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:id="@+id/ivFullscreen"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_full_screen"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/vsReplay"
        android:layout="@layout/ls_view_replay_overlay"
        android:inflatedId="@+id/replayOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/vsError"
        android:layout="@layout/ls_view_player_error_overlay"
        android:inflatedId="@+id/errorOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
