<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.noober.background.view.BLView
        android:id="@+id/rankContentLoadingCover1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        app:bl_corners_topRadius="4dp"
        app:bl_solid_color="@color/skeleton"
        app:layout_constraintDimensionRatio="1:1.39"
        app:layout_constraintEnd_toStartOf="@+id/rankContentLoadingCover2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/rankContentLoadingTitle1"
        android:layout_width="0dp"
        android:layout_height="27dp"
        android:layout_marginTop="0.5dp"
        app:bl_corners_bottomRadius="4dp"
        app:bl_solid_color="@color/skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rankContentLoadingCover1"
        app:layout_constraintStart_toStartOf="@+id/rankContentLoadingCover1"
        app:layout_constraintTop_toBottomOf="@+id/rankContentLoadingCover1"/>
    <com.noober.background.view.BLView
        android:id="@+id/rankContentLoadingCover2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:bl_corners_topRadius="4dp"
        app:bl_solid_color="@color/skeleton"
        app:layout_constraintDimensionRatio="1:1.39"
        app:layout_constraintEnd_toStartOf="@+id/rankContentLoadingCover3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/rankContentLoadingCover1"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/rankContentLoadingTitle2"
        android:layout_width="0dp"
        android:layout_height="27dp"
        app:bl_corners_bottomRadius="4dp"
        app:bl_solid_color="@color/skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rankContentLoadingCover2"
        app:layout_constraintStart_toStartOf="@+id/rankContentLoadingCover2"
        app:layout_constraintTop_toBottomOf="@+id/rankContentLoadingCover2"/>
    <com.noober.background.view.BLView
        android:id="@+id/rankContentLoadingCover3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="32dp"
        app:bl_corners_topRadius="4dp"
        app:bl_solid_color="@color/skeleton"
        app:layout_constraintDimensionRatio="1:1.39"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/rankContentLoadingCover2"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/rankContentLoadingTitle3"
        android:layout_width="0dp"
        android:layout_height="27dp"
        app:bl_corners_bottomRadius="4dp"
        app:bl_solid_color="@color/skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rankContentLoadingCover3"
        app:layout_constraintStart_toStartOf="@+id/rankContentLoadingCover3"
        app:layout_constraintTop_toBottomOf="@+id/rankContentLoadingCover3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
