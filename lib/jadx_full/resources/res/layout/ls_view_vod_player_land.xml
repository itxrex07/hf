<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:textColor="@color/ls_white"
        android:id="@+id/tvSeekPreviewLand"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/style_font_600"/>
    <View
        android:id="@+id/vTopScrim"
        android:background="@drawable/ls_bg_player_top_bar"
        android:layout_width="0dp"
        android:layout_height="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vControlBarScrimLand"
        android:background="@drawable/ls_bg_player_control_bar"
        android:layout_width="0dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/centerControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ls_view_player_center_control"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llLock"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_unlock"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ls_white"
            android:id="@+id/tvLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ls_player_lock"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomControlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ls_white"
                android:id="@+id/tvCurTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:shadowColor="@color/ls_gray_dark_00"
                android:shadowDy="2"
                android:shadowRadius="2"
                style="@style/style_font_400"/>
            <com.transsion.livesports.base.widget.SecondariesSeekBar
                android:id="@+id/seekBarLand"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:ssb_bar_center_color="@color/ls_brand_gradient_center"
                app:ssb_bar_end_color="@color/ls_brand_gradient_end"
                app:ssb_bar_start_color="@color/ls_brand_gradient_start"
                app:ssb_bg_color="@color/ls_white_40"
                app:ssb_secondaries_color="@color/ls_white_80"
                app:ssb_thumb_color="@color/ls_white"
                app:ssb_thumb_size="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ls_white"
                android:gravity="end"
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:shadowColor="@color/ls_gray_dark_00"
                android:shadowDy="2"
                android:shadowRadius="2"
                style="@style/style_font_400"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/ivPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ls_ic_player_pause"
                android:scaleType="centerInside"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ls_white"
                android:gravity="center"
                android:id="@+id/tvScale"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Fit"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/ls_ic_player_scale_fit"
                android:paddingHorizontal="10dp"
                style="@style/style_font_400"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ls_white"
                android:gravity="center"
                android:id="@+id/tvSpeed"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1x"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/ls_ic_player_speed"
                android:paddingHorizontal="10dp"
                style="@style/style_font_400"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ls_white"
                android:gravity="center"
                android:id="@+id/tvExitFullscreen"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ls_player_rotate"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/ls_ic_player_rotate"
                android:paddingHorizontal="10dp"
                style="@style/style_font_400"/>
        </LinearLayout>
    </LinearLayout>
    <ViewStub
        android:id="@+id/vsReplay"
        android:layout="@layout/ls_view_replay_overlay"
        android:inflatedId="@+id/replayOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ls_ic_detail_back"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
