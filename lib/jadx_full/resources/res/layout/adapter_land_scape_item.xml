<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bg_gradient"
        android:background="@drawable/bg_category_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="102dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="16dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">
            <com.noober.background.view.BLConstraintLayout
                android:id="@+id/cover_container"
                android:layout_width="120dp"
                android:layout_height="68dp"
                app:bl_corners_radius="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/corner_style_4"/>
                <com.noober.background.view.BLConstraintLayout
                    android:id="@+id/tag_audio"
                    android:paddingLeft="6dp"
                    android:paddingTop="2dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    app:bl_corners_radius="2dp"
                    app:bl_solid_color="@color/black_80"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.tn.lib.widget.TnTextView
                        android:textSize="11sp"
                        android:textColor="@color/white_80"
                        android:id="@+id/tv_audio_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/style_regular_text"/>
                </com.noober.background.view.BLConstraintLayout>
                <com.noober.background.view.BLLinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tag_duration"
                    android:paddingLeft="6dp"
                    android:paddingTop="2dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_margin="2dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    app:bl_corners_radius="2dp"
                    app:bl_solid_color="@color/black_80"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_res_post_type"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_tag_movie"
                        android:layout_marginEnd="4dp"/>
                    <com.tn.lib.widget.TnTextView
                        android:textSize="11sp"
                        android:textColor="@color/white_80"
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/style_regular_text"/>
                </com.noober.background.view.BLLinearLayout>
                <com.noober.background.view.BLConstraintLayout
                    android:id="@+id/tag_ranking"
                    android:paddingLeft="4dp"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="20dp"
                    android:minHeight="20dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    app:bl_corners_bottomLeftRadius="4dp"
                    app:bl_corners_bottomRightRadius="1dp"
                    app:bl_corners_topLeftRadius="1dp"
                    app:bl_corners_topRightRadius="4dp"
                    app:bl_solid_color="@color/black_80"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.tn.lib.widget.TnTextView
                        android:textSize="12sp"
                        android:textColor="@color/white_100"
                        android:id="@+id/tv_ranking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/style_import_text"/>
                </com.noober.background.view.BLConstraintLayout>
            </com.noober.background.view.BLConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/info_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cover_container"
                app:layout_constraintTop_toTopOf="parent">
                <com.tn.lib.widget.TnTextView
                    android:textColor="@color/white_100"
                    android:ellipsize="end"
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/style_regular_text"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title">
                    <com.tn.lib.widget.TnTextView
                        android:textSize="11sp"
                        android:textColor="@color/white_50"
                        android:ellipsize="end"
                        android:id="@+id/tv_views"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/style_regular_text"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
