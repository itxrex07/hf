<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="28dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBoostBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guidelineBoostSplit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:guidelineUseRtl="true"
            app:layout_constraintGuide_begin="168dp"/>
        <View
            android:id="@+id/vBoostHomeBg"
            android:background="@drawable/ls_detail_card_bg_home"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guidelineBoostSplit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/vBoostAwayBg"
            android:background="@drawable/ls_detail_card_bg_away"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ivBoostSlant"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivBoostSlant"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ls_detail_card_bg_center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guidelineBoostSplit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/ivBoostIconHome"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ls_ic_detail_like"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ls_white_80"
            android:id="@+id/tvHomePct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBoostIconHome"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_font_600"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ls_white_60"
            android:id="@+id/tvFansVoted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_font_600"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ls_white_80"
            android:id="@+id/tvAwayPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivBoostIconAway"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_font_600"/>
        <ImageView
            android:id="@+id/ivBoostIconAway"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ls_ic_detail_like"
            android:scaleX="-1"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <View
            android:id="@+id/vClickAreaHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/vClickAreaAway"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
