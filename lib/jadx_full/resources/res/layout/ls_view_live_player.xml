<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/vVideoLoadingBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="@color/ls_brand_gradient_center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vControlBarScrim"
        android:background="@drawable/ls_bg_player_control_bar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottomControlBar"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/ivPlayPause"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_pause"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/ivRefresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_refresh"
            android:scaleType="centerInside"
            android:layout_marginStart="12dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivPip"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_pip"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/ivFullscreen"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ls_ic_player_full_screen"
            android:scaleType="centerInside"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/vsError"
        android:layout="@layout/ls_view_player_error_overlay"
        android:inflatedId="@+id/errorOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
