<?xml version="1.0" encoding="utf-8"?>
<com.transsion.baseui.widget.RoundedConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_radius_6_color_white"
    android:layout_width="104dp"
    android:layout_height="146dp"
    app:cornerRadius="6dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProduct"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/ecommerce_rank_1_text"
        android:gravity="top|center_horizontal"
        android:id="@+id/tvRank"
        android:background="@mipmap/bg_ecommerce_rank_1"
        android:paddingTop="2dp"
        android:layout_width="19dp"
        android:layout_height="22dp"
        app:layout_constraintStart_toStartOf="@+id/ivProduct"
        app:layout_constraintTop_toTopOf="@+id/ivProduct"
        style="@style/style_text_900"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/gray_dark_00"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toBottomOf="@+id/ivProduct"
        style="@style/style_text_400"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llPriceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/pink_50"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tvPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            style="@style/style_text_900"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="9sp"
            android:textColor="@color/ecommerce_discount_text"
            android:gravity="center"
            android:id="@+id/tvDiscount"
            android:background="@drawable/bg_ecommerce_discount"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            style="@style/style_text_700"/>
    </LinearLayout>
</com.transsion.baseui.widget.RoundedConstraintLayout>
