<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/contentCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/gray_light_00"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/call_to_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/mediaWrap"
                android:layout_width="match_parent"
                android:layout_height="200dp">
                <com.hisavana.mediation.ad.TMediaView
                    android:id="@+id/ad_media"
                    android:background="@color/black_10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:sspScaleType="centerCrop"/>
                <LinearLayout
                    android:layout_gravity="start|top"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp">
                    <com.transsion.ad.view.AdTagView
                        android:id="@+id/adIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/adChoicesViewCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp">
                        <com.hisavana.mediation.ad.TAdChoicesView
                            android:id="@+id/adChoicesView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/flVolumeContainer"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="9dp"
                    android:layout_marginStart="9dp"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/adInfoPanel"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/native_ad_icon_card"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/native_ad_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed">
                    <com.hisavana.mediation.ad.TIconView
                        android:id="@+id/native_ad_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/gray_light_80"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/native_ad_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:textAlignment="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/native_ad_description"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/native_ad_icon_card"
                    style="@style/style_import_text"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/gray_light_70"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/native_ad_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="12dp"
                    android:maxLines="4"
                    android:includeFontPadding="false"
                    android:textAlignment="center"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/native_ad_title"
                    style="@style/style_regular_text"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/gray_dark_00"
        android:gravity="center"
        android:id="@+id/call_to_action"
        android:background="@drawable/bg_gradient_brand_4"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/style_import_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
