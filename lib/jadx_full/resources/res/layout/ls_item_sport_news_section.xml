<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/ls_text_size_14"
            android:textColor="@color/ls_white"
            android:ellipsize="end"
            android:id="@+id/ls_tv_sport_news_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ls_sport_news_section_title"
            android:maxLines="1"
            android:layout_weight="1"
            style="@style/style_font_700"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ls_ll_sport_news_all"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">
            <TextView
                android:textSize="@dimen/ls_text_size_12"
                android:textColor="@color/ls_white_60"
                android:id="@+id/ls_tv_sport_news_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ls_sport_news_all"
                android:lineSpacingExtra="4dp"
                style="@style/style_font_400"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ls_ic_arrow_right"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ls_ll_sport_news_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
</LinearLayout>
