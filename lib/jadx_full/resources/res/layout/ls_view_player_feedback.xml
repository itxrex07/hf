<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/feedbackRoot"
    android:background="@drawable/ls_bg_player_seek_preview"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/ivFeedbackIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/pbFeedback"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:max="100"
            android:progressDrawable="@drawable/ls_progress_drawable_player"
            android:layout_marginVertical="9dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <ProgressBar
            android:id="@+id/pbFeedbackBrand"
            android:visibility="gone"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:max="100"
            android:progressDrawable="@drawable/ls_progress_drawable_player_brand"
            android:layout_marginVertical="9dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tipsLayout"
            android:visibility="gone"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:layout_marginVertical="9dp">
            <View
                android:background="@drawable/ls_shape_player_tips_bg"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ls_brand_gradient_center"
                android:gravity="end|center_vertical"
                android:id="@+id/tvTipsPercent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:paddingEnd="2dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
