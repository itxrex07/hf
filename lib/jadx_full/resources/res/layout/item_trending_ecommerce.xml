<?xml version="1.0" encoding="utf-8"?>
<com.transsion.baseui.widget.RoundedConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ecommerce_module"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    app:cornerRadius="6dp">
    <ImageView
        android:id="@+id/ecommerce_deco_bag"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginTop="6dp"
        android:src="@mipmap/ic_ecommerce_bag_deco"
        android:contentDescription="@null"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ecommerce_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="9dp"
        android:src="@mipmap/ic_ecommerce_bag"
        android:contentDescription="@null"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@+id/ecommerce_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ecommerce_icon"
        app:layout_constraintStart_toEndOf="@+id/ecommerce_icon"
        app:layout_constraintTop_toTopOf="@+id/ecommerce_icon"
        style="@style/style_text_900"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white_60"
        android:gravity="end"
        android:id="@+id/ecommerce_more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="8dp"
        app:drawableEndCompat="@drawable/libui_ic_medium_arrow_right"
        app:drawableTint="@color/white_60"
        app:layout_constraintBottom_toBottomOf="@+id/ecommerce_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_text_400"/>
    <com.transsion.baseui.widget.OperateScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecommerce_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ecommerce_recycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </com.transsion.baseui.widget.OperateScrollableHost>
</com.transsion.baseui.widget.RoundedConstraintLayout>
