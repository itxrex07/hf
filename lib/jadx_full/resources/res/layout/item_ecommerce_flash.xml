<?xml version="1.0" encoding="utf-8"?>
<com.transsion.baseui.widget.RoundedConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_radius_6_color_white"
    android:layout_width="104dp"
    android:layout_height="174dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProduct"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/corner_style_top_6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/gray_dark_00"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toBottomOf="@+id/ivProduct"
        style="@style/style_text_400"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/pink_50"
        android:gravity="start"
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/style_text_900"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/ecommerce_discount_text"
        android:gravity="center"
        android:id="@+id/tvDiscount"
        android:background="@drawable/bg_ecommerce_flash_discount"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvBuy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPrice"
        style="@style/style_text_700"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvBuy"
        android:background="@drawable/bg_ecommerce_buy"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:text="@string/ecommerce_buy"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDiscount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvDiscount"
        app:layout_constraintTop_toTopOf="@+id/tvDiscount"
        style="@style/style_text_900"/>
    <ImageView
        android:id="@+id/ivBolt"
        android:layout_width="14dp"
        android:layout_height="24dp"
        android:src="@mipmap/ic_ecommerce_bolt"
        android:contentDescription="@null"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDiscount"
        app:layout_constraintEnd_toStartOf="@+id/tvBuy"
        app:layout_constraintStart_toEndOf="@+id/tvDiscount"
        app:layout_constraintTop_toTopOf="@+id/tvDiscount"/>
</com.transsion.baseui.widget.RoundedConstraintLayout>
