<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:bl_corners_radius="16dp"
    app:bl_solid_color="@color/gray_dark_20">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white_80"
        android:gravity="center"
        android:id="@+id/premiumLinkedMessage"
        android:layout_width="232dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:includeFontPadding="false"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_regular_text"/>
    <com.noober.background.view.BLTextView
        android:textSize="14sp"
        android:textColor="@color/gray_dark_00"
        android:gravity="center"
        android:id="@+id/premiumLinkedConfirm"
        android:layout_width="232dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:text="@string/login_premium_link_confirm"
        app:bl_corners_radius="6dp"
        app:bl_gradient_angle="0"
        app:bl_gradient_centerColor="@color/brand_new_gradient_center"
        app:bl_gradient_endColor="@color/brand_new_gradient_end"
        app:bl_gradient_startColor="@color/brand_new_gradient_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/premiumLinkedMessage"
        style="@style/style_import_text"/>
</com.noober.background.view.BLConstraintLayout>
