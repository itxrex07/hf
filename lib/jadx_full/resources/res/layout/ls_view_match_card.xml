<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ls_bg_match_card_live"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivHomeLogo"
        android:background="#1affffff"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/tvScoreHome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ls_corner_style_circle"/>
    <com.transsion.livesports.base.widget.GradientBorderView
        android:id="@+id/vHomeLogoStroke"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="2dp"
        app:bl_corners_radius="14dp"
        app:layout_constraintStart_toStartOf="@+id/ivHomeLogo"
        app:layout_constraintTop_toTopOf="@+id/ivHomeLogo"
        app:lsGradientBorderDirection="topToBottom"
        app:lsGradientBorderEndColor="@android:color/transparent"
        app:lsGradientBorderRadius="14dp"
        app:lsGradientBorderStartColor="@color/ls_white_30"
        app:lsGradientBorderWidth="0.7dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvHomeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/tvScoreHome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHomeLogo"
        app:layout_constraintWidth_max="85dp"/>
    <com.transsion.livesports.base.widget.GradientTextView
        android:textSize="20sp"
        android:id="@+id/tvScoreHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginEnd="4dp"
        app:gradientTvCenterColor="@color/ls_brand_gradient_center"
        app:gradientTvEndColor="@color/ls_brand_gradient_end"
        app:gradientTvStartColor="@color/ls_brand_gradient_start"
        app:layout_constraintBottom_toBottomOf="@+id/ivHomeLogo"
        app:layout_constraintEnd_toStartOf="@+id/vDivider"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintTop_toTopOf="@+id/ivHomeLogo"
        style="@style/style_font_700"/>
    <com.noober.background.view.BLView
        android:id="@+id/vDivider"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:bl_corners_radius="2dp"
        app:bl_gradient_angle="0"
        app:bl_gradient_centerColor="@color/ls_brand_gradient_center"
        app:bl_gradient_endColor="@color/ls_brand_gradient_end"
        app:bl_gradient_startColor="@color/ls_brand_gradient_start"
        app:layout_constraintBottom_toBottomOf="@+id/tvScoreHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvScoreHome"/>
    <com.transsion.livesports.base.widget.GradientTextView
        android:textSize="20sp"
        android:id="@+id/tvScoreAway"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_marginStart="4dp"
        app:gradientTvCenterColor="@color/ls_brand_gradient_center"
        app:gradientTvEndColor="@color/ls_brand_gradient_end"
        app:gradientTvStartColor="@color/ls_brand_gradient_start"
        app:layout_constraintBottom_toBottomOf="@+id/tvScoreHome"
        app:layout_constraintStart_toEndOf="@+id/vDivider"
        app:layout_constraintTop_toTopOf="@+id/tvScoreHome"
        style="@style/style_font_700"/>
    <com.transsion.livesports.base.widget.GradientTextView
        android:textSize="12sp"
        android:id="@+id/tvStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:gradientTvCenterColor="@color/ls_brand_gradient_center"
        app:gradientTvEndColor="@color/ls_brand_gradient_end"
        app:gradientTvStartColor="@color/ls_brand_gradient_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvScoreHome"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAwayLogo"
        android:background="#1affffff"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvScoreAway"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ls_corner_style_circle"/>
    <com.transsion.livesports.base.widget.GradientBorderView
        android:id="@+id/vAwayLogoStroke"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="2dp"
        app:bl_corners_radius="14dp"
        app:layout_constraintStart_toStartOf="@+id/ivAwayLogo"
        app:layout_constraintTop_toTopOf="@+id/ivAwayLogo"
        app:lsGradientBorderDirection="topToBottom"
        app:lsGradientBorderEndColor="@android:color/transparent"
        app:lsGradientBorderRadius="14dp"
        app:lsGradientBorderStartColor="@color/ls_white_30"
        app:lsGradientBorderWidth="0.7dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvAwayName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvScoreAway"
        app:layout_constraintTop_toBottomOf="@+id/ivAwayLogo"
        app:layout_constraintWidth_max="85dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierTeamAreaBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvHomeName,tvAwayName"/>
    <com.transsion.livesports.detail.ui.widget.LiveSportsBoostBarView
        android:id="@+id/lsBoostBar"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierTeamAreaBottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
