<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bl_corners_radius="4dp"
    app:bl_solid_color="@color/ls_white_06">
    <com.noober.background.view.BLView
        android:id="@+id/vBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:bl_corners_radius="4dp"
        app:bl_gradient_angle="0"
        app:bl_gradient_centerColor="@color/ls_brand_gradient_center_20"
        app:bl_gradient_endColor="@color/ls_brand_gradient_end_20"
        app:bl_gradient_startColor="@color/ls_brand_gradient_start_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBanner"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ls_corner_style_top_4"/>
    <com.noober.background.view.BLTextView
        android:textSize="10sp"
        android:textColor="@color/ls_white"
        android:gravity="center"
        android:id="@+id/tvReplayTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:text="@string/ls_detail_replay_tag"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp"
        app:bl_corners_radius="2dp"
        app:bl_gradient_angle="0"
        app:bl_gradient_endColor="@color/ls_color_replay_tag_end"
        app:bl_gradient_startColor="@color/ls_color_replay_tag_start"
        app:bl_stroke_color="@color/ls_white_20"
        app:bl_stroke_width="1dp"
        app:layout_constraintStart_toStartOf="@+id/ivBanner"
        app:layout_constraintTop_toTopOf="@+id/ivBanner"
        style="@style/style_font_600"/>
    <com.noober.background.view.BLTextView
        android:textSize="11sp"
        android:textColor="@color/ls_white_80"
        android:gravity="center"
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginBottom="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:layout_marginEnd="2dp"
        app:bl_corners_radius="2dp"
        app:bl_solid_color="@color/ls_black_80"
        app:layout_constraintBottom_toBottomOf="@+id/ivBanner"
        app:layout_constraintEnd_toEndOf="@+id/ivBanner"
        style="@style/style_font_400"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llLiveTag"
        android:background="@drawable/ls_bg_tag_live"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_margin="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBanner"
        app:layout_constraintEnd_toEndOf="@+id/ivBanner">
        <ImageView
            android:id="@+id/ivLiveGif"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:scaleType="centerCrop"/>
        <com.transsion.livesports.base.widget.GradientTextView
            android:textSize="11sp"
            android:id="@+id/tvLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ls_detail_live_tag"
            android:layout_marginStart="2dp"
            app:gradientTvCenterColor="@color/ls_brand_gradient_center"
            app:gradientTvEndColor="@color/ls_brand_gradient_end"
            app:gradientTvStartColor="@color/ls_brand_gradient_start"
            style="@style/style_font_700"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ls_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBanner"
        style="@style/style_font_400"/>
    <com.transsion.livesports.base.widget.GradientBorderView
        android:id="@+id/vBorder"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lsGradientBorderCenterColor="@color/ls_brand_gradient_center"
        app:lsGradientBorderDirection="leftToRight"
        app:lsGradientBorderEndColor="@color/ls_brand_gradient_end"
        app:lsGradientBorderRadius="4dp"
        app:lsGradientBorderStartColor="@color/ls_brand_gradient_start"
        app:lsGradientBorderWidth="1dp"/>
</com.noober.background.view.BLConstraintLayout>
