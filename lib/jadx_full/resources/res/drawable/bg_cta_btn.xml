<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <gradient
                android:startColor="@color/ecommerce_cta_start"
                android:endColor="@color/ecommerce_cta_end"
                android:angle="0"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <gradient
                android:startColor="@color/white_40"
                android:endColor="@color/white_0"
                android:angle="0"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient
                android:startColor="@color/ecommerce_cta_start"
                android:endColor="@color/ecommerce_cta_end"
                android:angle="0"/>
        </shape>
    </item>
</layer-list>
